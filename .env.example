# PostgreSQL. Локально — из docker compose. На Render подставится само.
DATABASE_URL="postgresql://cabinet:cabinet@127.0.0.1:5432/cabinet"

# AlfaCRM KIBERone Караганда. Пока поля пустые, кабинет работает в демо-режиме
# на встроенных учебных данных и не ходит в настоящую CRM.
ALFACRM_HOST="kiberonekaraganda.s20.online"
ALFACRM_EMAIL=""
ALFACRM_API_KEY=""
# Филиал Караганды в AlfaCRM. Проверено: 1.
ALFACRM_BRANCH_ID="1"

# 1 — всегда демо, даже если ключ заполнен. 0 или пусто — живой режим, когда заданы все четыре поля выше.
ALFACRM_MOCK=""

# Необязательно: имя поля карточки клиента, если бонусы лежат не в стандартном счёте.
# Например balance_bonus или custom_kiberony.
ALFACRM_BONUS_FIELD=""

# Секрет для плановой синхронизации: curl -H "Authorization: Bearer ..." https://кабинет/api/cron/sync
CRON_SECRET=""

# Как часто процесс сам синхронизирует CRM, в минутах. 0 — только кнопка и внешний cron.
SYNC_INTERVAL_MINUTES="360"

# 0 на боевом сайте: не создавать вымышленных учеников. Локально оставьте пустым или 1.
SEED_DEMO="1"
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="Kabinet-Admin-2026"

# 1 — показать на странице входа учебные логины. Пусто — показывать только в демо-режиме.
SHOW_DEMO_LOGINS=""
